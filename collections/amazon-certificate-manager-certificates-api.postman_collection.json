              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/certificates?maxItems=<integer>&nextToken=<string>&certificateStatuses=INACTIVE&certificateStatuses=EXPIRED",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "certificates"
              ],
              "query": [
                {
                  "description": "Maximum number of certificates to return.",
                  "key": "maxItems",
                  "value": "<integer>"
                },
                {
                  "description": "Token for pagination.",
                  "key": "nextToken",
                  "value": "<string>"
                },
                {
                  "description": "Filter by certificate status.",
                  "key": "certificateStatuses",
                  "value": "INACTIVE"
                },
                {
